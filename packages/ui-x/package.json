{
  "name": "@soybeanjs/ui-x",
  "version": "0.31.0",
  "description": "SoybeanUIX provides styled AI conversation components for Vue 3, built on top of SoybeanHeadless and SoybeanUI.",
  "homepage": "https://github.com/soybeanjs/soybean-ui",
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/soybean-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js",
      "require": "./dist/composables/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "import": "./dist/resolver/index.js",
      "require": "./dist/resolver/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack && pnpm build:css",
    "build:css": "unocss --minify",
    "test": "vp test run",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@soybeanjs/cva": "^0.1.1",
    "@soybeanjs/headless": "workspace:^",
    "@soybeanjs/theme": "workspace:^",
    "@soybeanjs/ui": "workspace:^",
    "markstream-vue": "^2.0.11"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@soybeanjs/ui-uno": "workspace:^",
    "@types/node": "^26.5.0",
    "@unocss/cli": "^66.10.1",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.0",
    "playwright": "^1.63.0",
    "typescript": "catalog:",
    "unocss": "^66.10.1",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plus": "catalog:",
    "vitest": "5.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.3.0",
    "@nuxt/schema": "^4.3.0",
    "mermaid": "^11.0.0",
    "nuxt": ">=4.0.0",
    "shiki": ">=1.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vue": ">=3.2.0",
    "vue-router": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  }
}
