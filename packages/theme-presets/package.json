{
  "name": "@soybeanjs/theme-presets",
  "version": "0.29.3",
  "description": "External preset collection for @soybeanjs/theme — override builtin themes with base/feedback/chart/theme presets.",
  "homepage": "https://github.com/soybeanjs/soybean-ui",
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/soybean-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./base/*": {
      "types": "./dist/generated/base/*.d.ts",
      "import": "./dist/generated/base/*.js",
      "require": "./dist/generated/base/*.js"
    },
    "./feedback/*": {
      "types": "./dist/generated/feedback/*.d.ts",
      "import": "./dist/generated/feedback/*.js",
      "require": "./dist/generated/feedback/*.js"
    },
    "./chart/*": {
      "types": "./dist/generated/chart/*.d.ts",
      "import": "./dist/generated/chart/*.js",
      "require": "./dist/generated/chart/*.js"
    },
    "./theme/*": {
      "types": "./dist/generated/theme/*.d.ts",
      "import": "./dist/generated/theme/*.js",
      "require": "./dist/generated/theme/*.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "build": "vp pack",
    "generate": "tsx scripts/generate.ts",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "validate": "tsx scripts/validate.ts"
  },
  "devDependencies": {
    "@soybeanjs/theme": "workspace:^",
    "@types/node": "^26.1.2",
    "fast-glob": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "valibot": "^1.4.2",
    "vite-plus": "catalog:",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
