{
  "name": "@vean/theme",
  "version": "0.50.0-beta.1",
  "description": "A lightweight theme engine for Vean: minimal core tokens, deterministic derivation, and light/dark level offsets.",
  "homepage": "https://github.com/soybeanjs/vean",
  "bugs": {
    "url": "https://github.com/soybeanjs/vean/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/vean.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "require": "./dist/storage.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@soybeanjs/colord": "^0.8.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.1"
  }
}
