{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "vite-plugin-vue-meta-layouts/client"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["../../packages/ui/src/*"],
      "@playground/*": ["../playground/src/*"],
      "@soybeanjs/ui": ["../../packages/ui/src/index.ts"],
      "@soybeanjs/ui-x": ["../../packages/ui-x/src/index.ts"],
      "@soybeanjs/theme": ["../../packages/theme/src/index.ts"],
      "@soybeanjs/theme/*": ["../../packages/theme/src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.d.ts", "./**/*.tsx", "./**/*.vue"]
}
