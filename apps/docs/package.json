{
  "name": "@soybeanjs/ui-docs",
  "version": "0.31.0",
  "private": true,
  "description": "SoybeanUI Docs is a documentation for SoybeanUI. It is designed to be easy to use and understand.",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:registry && ubean build && pnpm build:seo",
    "build:registry": "pnpm --filter sbean build:registry && vp fmt public/r --write",
    "build:schema": "pnpm --filter sbean build:schema",
    "build:seo": "tsx build/seo.ts",
    "dev": "ubean dev",
    "preview": "ubean preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.4",
    "@soybeanjs/colord": "^0.7.1",
    "@soybeanjs/headless": "workspace:^",
    "@soybeanjs/theme": "workspace:^",
    "@soybeanjs/ui": "workspace:^",
    "@soybeanjs/ui-x": "workspace:^",
    "@tanstack/charts": "^0.16.2",
    "@ubean/content": "0.4.9",
    "@unhead/vue": "^3.4.0",
    "@vueuse/core": "^14.4.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.4.3",
    "ubean": "^0.4.9",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@soybeanjs/ui-uno": "workspace:^",
    "@soybeanjs/unocss-preset": "^0.2.0",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "typescript": "catalog:",
    "unocss": "^66.10.1",
    "vite-plus": "catalog:"
  }
}
